# Copy to journey/server/.env for local development.
# Never commit .env. The server reads this file only for keys that are
# not already set in the environment.

# Postgres. Local docker-compose default, or any Postgres you can reach.
DATABASE_URL=postgres://casedesk:casedesk@127.0.0.1:5432/casedesk

# Signs session cookies and peppers token hashes. Use a long random string.
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# development | test | production
# production: Secure cookies, HSTS, and no on-screen magic links.
NODE_ENV=development

# Public origin used inside magic-link emails. No trailing slash.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Resend HTTPS API (not SMTP). Leave blank locally: the link is logged and
# returned on screen. In production a blank key disables sign-in email
# instead of revealing the link.
RESEND_API_KEY=

# Sender once nextsteps.fun is verified at Resend.
EMAIL_FROM=The Case Desk <no-reply@nextsteps.fun>
# Optional human inbox for replies. Not required for magic links.
EMAIL_REPLY_TO=

# Comma-separated emails allowed to open /admin. Same magic-link sign-in.
ADMIN_EMAILS=

# Practice purchases. 1 = the in-app "practice code" button is on.
# 0 = off. When unset: on outside production, off in production.
# This never calls Etsy. Real listings use ETSY_LISTING_URL later.
MOCK_COMMERCE=1

# Drop-in for the real Etsy listing. Empty until the shop exists.
ETSY_LISTING_URL=

# Listen port. Railway sets PORT. Local default is 8080.
PORT=8080
